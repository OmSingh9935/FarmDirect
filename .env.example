# FarmDirect Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Default: local SQLite file for zero-friction setup)
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Docker): postgresql://postgres:postgrespassword@localhost:5432/farmdirect?schema=public

# Authentication & Sessions
JWT_SECRET=farmdirect_jwt_super_secret_key_prod_2026_dev
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=7

# Email Provider (SMTP / Resend / Console)
# In development, leave empty or set EMAIL_PROVIDER=console to view OTP in console and UI helper
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="FarmDirect <noreply@farmdirect.market>"
RESEND_API_KEY=re_your_resend_api_key

# Payment Gateway (Razorpay Sandbox)
# If empty or test keys are used, sandbox simulator handles test orders seamlessly
RAZORPAY_KEY_ID=rzp_test_farmdirect12345
RAZORPAY_KEY_SECRET=secret_test_farmdirect67890
RAZORPAY_WEBHOOK_SECRET=webhook_secret_farmdirect

# Logistics & Platform Defaults
DEFAULT_COMMISSION_PERCENTAGE=5.0
DEFAULT_QUINTAL_THRESHOLD=0.5
